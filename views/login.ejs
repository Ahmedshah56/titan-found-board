<%- include('partials/header') %>
<div class="auth-shell">
    <div class="auth-card p-10 w-full max-w-md">

        <div class="text-center mb-8">
            <div class="auth-badge">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2 3 7v6c0 5 4 9 9 9s9-4 9-9V7l-9-5Z"/><path d="m9 12 2 2 4-4"/></svg>
            </div>
            <h1 class="text-3xl font-black tracking-tight text-gray-900">TITAN</h1>
            <p class="text-xs uppercase tracking-wider text-gray-400 font-bold mt-1">Campus Lost &amp; Found Board</p>
        </div>

        <div id="form-error" class="alert-error" style="<%= error ? '' : 'display:none;' %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
            <span id="form-error-text"><%= error || '' %></span>
        </div>

        <form id="login-form" class="flex flex-col gap-4">
            <div>
                <label class="block text-xs font-bold text-gray-600 uppercase tracking-wide mb-1">Email Address</label>
                <input type="email" name="email" required placeholder="you@titan.edu.pk" class="custom-input">
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-600 uppercase tracking-wide mb-1">Password</label>
                <input type="password" name="password" required placeholder="••••••••" class="custom-input">
            </div>

            <button type="submit" id="login-btn" class="btn-primary mt-2">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><path d="M10 17l5-5-5-5"/><path d="M15 12H3"/></svg>
                Sign In
            </button>
        </form>

        <p class="text-center text-xs text-gray-500 mt-6">
            Don't have an account yet? <a href="/signup" class="text-titanGold font-bold" style="color: var(--gold-dark); text-decoration: none;">Sign up here</a>
        </p>
    </div>
</div>

</body>
</html>
